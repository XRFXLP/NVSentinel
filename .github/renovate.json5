  // Renovate updates only what Dependabot cannot: the tool versions in
  // .versions.yaml. Dependabot keeps gomod, pip, docker and github-actions.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  enabledManagers: ["custom.regex"],
  dependencyDashboard: false,
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  commitMessagePrefix: "chore(deps):",
  // The default hourly limit (2) would hold back most groups on a weekly run.
  prConcurrentLimit: 10,
  prHourlyLimit: 10,
  labels: ["dependencies"],

  customManagers: [
    {
      // Each pin has an annotation on the line above it:
      //   # renovate: datasource=<ds> depName=<name> depType=<top-level section>
      customType: "regex",
      managerFilePatterns: ["/^\\.versions\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) depType=(?<depType>\\S+)\\s*\\n\\s*\\S+:\\s*['\"](?<currentValue>[^'\":]+)['\"]",
      ],
    },
  ],

  packageRules: [
    {
      // One PR per .versions.yaml section.
      matchManagers: ["custom.regex"],
      groupName: "{{depType}} tools",
    },
    {
      // These pins drop the leading v that the upstream tags carry.
      matchDepNames: ["kubernetes-sigs/kind", "tilt-dev/ctlptl", "tilt-dev/tilt", "cert-manager"],
      extractVersion: "^v?(?<version>.+)$",
    },
    {
      matchDepNames: ["kwok"],
      registryUrls: ["https://kwok.sigs.k8s.io/charts/"],
    },
    {
      matchDepNames: ["kube-prometheus-stack"],
      registryUrls: ["https://prometheus-community.github.io/helm-charts"],
    },
    {
      matchDepNames: ["gpu-operator"],
      registryUrls: ["https://helm.ngc.nvidia.com/nvidia"],
    },
    {
      matchDepNames: ["cert-manager"],
      registryUrls: ["https://charts.jetstack.io"],
    },
    {
      matchDepNames: ["policy-controller"],
      registryUrls: ["https://sigstore.github.io/helm-charts"],
    },
  ],
}
