# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /webhook .

# Runtime stage
FROM gcr.io/distroless/static:nonroot

COPY --from=builder /webhook /webhook

USER nonroot:nonroot

ENTRYPOINT ["/webhook"]